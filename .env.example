# ---------------------------------------------------------------
# Dispatch backend configuration. Copy to .env and fill in.
# Only JINA_API_KEY and one LLM key are required; everything else
# has a working default.
# ---------------------------------------------------------------

PORT=5000

# Comma-separated list of browser origins allowed to call the API.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Embeddings (required) -------------------------------------
# Free key: https://jina.ai/embeddings
JINA_API_KEY=
# JINA_MODEL=jina-embeddings-v2-base-en
# EMBEDDING_DIMENSIONS=768

# --- LLM (at least one) ----------------------------------------
# Providers are tried in order: Gemini → Groq → OpenAI.

# Gemini. Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq. Free tier, no card needed. Key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b         # or qwen/qwen3.8-27b, openai/gpt-oss-20b (faster)

# OpenAI (or any OpenAI-compatible API).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vector store (optional) -----------------------------------
# Unset: a local JSON index at data/news-index.json (no infra needed).
# Set:   Qdrant (local Docker: http://localhost:6333, or Qdrant Cloud).
# QDRANT_URL=
# QDRANT_API_KEY=          # required for Qdrant Cloud
# QDRANT_COLLECTION=news_articles

# --- Session store (optional) ----------------------------------
# Unset: in-memory (lost on restart). Set: Redis.
# Upstash/managed Redis needs TLS: use a rediss:// URL.
# REDIS_URL=redis://localhost:6379
# SESSION_TTL_SECONDS=86400   # sliding expiry, refreshed on every message
# SESSION_MAX_MESSAGES=100

# --- Retrieval tuning ------------------------------------------
# RAG_TOP_K=6
# RAG_MIN_SCORE=0.74
# RAG_RELATIVE_CUTOFF=0.1
# RAG_HISTORY_MESSAGES=6

# --- Limits ----------------------------------------------------
# MAX_QUERY_CHARS=1000
# RATE_LIMIT_PER_MINUTE=20
# LOG_LEVEL=info
